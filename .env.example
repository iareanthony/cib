# ============================================
# CIB (Compliance in a Box) Configuration
# ============================================

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3003

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8431
VICTORIAMETRICS_RETENTION=90d

# ==================== Checker ====================
SCAN_INTERVAL_HOURS=6
SCAN_ON_STARTUP=true
TRIVY_TIMEOUT=300
# Extra images to check beyond running containers
# ADDITIONAL_IMAGES=nginx:latest,redis:7

# ==================== Remote Docker (Optional) ====================
# Scan one or more remote Docker daemons (docker-socket-proxy recommended).
# DOCKER_HOSTS takes priority; falls back to DOCKER_HOST; falls back to local socket.
# When using only remote hosts, remove the /var/run/docker.sock volume from docker-compose.yml.
#
# Single remote host:
# DOCKER_HOST=tcp://192.168.1.212:2375
#
# Multiple remote hosts (name=url pairs, comma-separated):
# DOCKER_HOSTS=docker-vm=tcp://192.168.1.212:2375,dockerhost=tcp://192.168.1.25:2375
#
# All per-container/image metrics get a host="" label so you can filter in Grafana.

# ==================== License Policy ====================
# Comma-separated SPDX license IDs to flag as violations
# Defaults to copyleft licenses (GPL, AGPL) — remove entries to relax policy

# Network exposure (127.0.0.1 is safe for local demos; set 0.0.0.0 for LAN exposure)
BIND_ADDR=127.0.0.1
